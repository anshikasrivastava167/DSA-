def length_of_lis(nums):
    if not nums:
        return 0

    tails = []

    for num in nums:
        left, right = 0, len(tails)
        while left < right:
            mid = (left + right) // 2
            if tails[mid] < num:
                left = mid + 1
            else:
                right = mid
        
        if left == len(tails):
            tails.append(num)
        else:
            tails[left] = num

    return len(tails)


nums = [10, 9, 2, 5, 3, 7, 101, 18]
print(length_of_lis(nums))  
